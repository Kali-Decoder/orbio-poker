# No-Limit Inference — root env template (copy into app envs; never commit secrets)

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nli?schema=public
REDIS_URL=redis://localhost:6379

# Orbio (OpenAI-compatible) — server only
ORBIO_API_KEY=sk-orbio-…
ORBIO_BASE_URL=https://api.orbio.so/api/v1

# Optional OpenAI drop-in aliases (also supported by @nli/orbio-client)
# OPENAI_API_KEY=sk-orbio-…
# OPENAI_BASE_URL=https://api.orbio.so/api/v1

# Optional Anthropic-compatible (CLI / Anthropic SDK)
# ANTHROPIC_BASE_URL=https://api.orbio.so/api
# ANTHROPIC_AUTH_TOKEN=sk-orbio-…
# ANTHROPIC_API_KEY=

# Example Orbio model ids
# ORBIO_DEFAULT_MODEL=anthropic/claude-fable-5.1
# ORBIO_DEFAULT_MODEL=openai/gpt-6-astra

TOKEN_ADDRESS=
CHAIN_ID=11155111
SEPOLIA_RPC_URL=

# Legacy off-chain server (apps/server) until Fastify migration
PORT=4000
MONGODB_URI=memory
CORS_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Privy (https://dashboard.privy.io → your App ID)
NEXT_PUBLIC_PRIVY_APP_ID=
