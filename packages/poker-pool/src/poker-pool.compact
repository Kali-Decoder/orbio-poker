pragma language_version >= 0.23;
import CompactStandardLibrary;

/**
 * Poker pool vault — one deploy = one market (fixed entry + chip multiplier).
 *
 * On-chain only: deposit (buy-in) and claim (cash-out).
 * Off-chain: chips = (entryAmount / 1e6 NIGHT Stars) * chipMultiplier, then play poker.
 * House settles claimable NIGHT after the off-chain game, then players claim on-chain.
 * On claim: 5% (500 bps) of the winning amount goes to the sealed treasury address.
 */

export sealed ledger entryAmount: Uint<128>;
export sealed ledger chipMultiplier: Uint<64>;
export sealed ledger house: Bytes<32>;
/** Unshielded address that receives the claim fee. */
export sealed ledger treasury: UserAddress;
/** Fee in basis points (500 = 5%). */
export sealed ledger treasuryFeeBps: Uint<16>;

export ledger vaultBalance: Uint<128>;
export ledger totalDeposited: Uint<128>;
export ledger totalClaimed: Uint<128>;
export ledger totalTreasuryFees: Uint<128>;
export ledger entrantCount: Counter;

/** Total Stars each seat has deposited into this pool. */
export ledger deposited: Map<UserAddress, Uint<128>>;

/** Stars the house has awarded for claim (after off-chain settlement). */
export ledger claimable: Map<UserAddress, Uint<128>>;

witness houseKey(): Bytes<32>;

constructor(
  entry: Uint<128>,
  multiplier: Uint<64>,
  houseSecret: Bytes<32>,
  treasuryAddress: UserAddress
) {
  assert(disclose(entry) > 0, "Entry amount must be positive");
  assert(disclose(multiplier) > 0, "Chip multiplier must be positive");

  entryAmount = disclose(entry);
  chipMultiplier = disclose(multiplier);
  house = disclose(deriveHouseKey(houseSecret));
  treasury = disclose(treasuryAddress);
  treasuryFeeBps = 500;
  vaultBalance = 0;
  totalDeposited = 0;
  totalClaimed = 0;
  totalTreasuryFees = 0;
}

/**
 * Buy into the pool: lock exactly `entryAmount` unshielded NIGHT (Stars).
 * Off-chain server then credits chips = night * chipMultiplier.
 */
export circuit deposit(player: UserAddress): [] {
  receiveUnshielded(nativeToken(), entryAmount);

  const prev = deposited.member(disclose(player))
    ? deposited.lookup(disclose(player))
    : 0;
  deposited.insert(
    disclose(player),
    disclose((prev + entryAmount) as Uint<128>)
  );

  vaultBalance = disclose((vaultBalance + entryAmount) as Uint<128>);
  totalDeposited = disclose((totalDeposited + entryAmount) as Uint<128>);
  entrantCount.increment(1);
}

/**
 * House sets absolute claimable Stars for a player after off-chain settlement.
 * Trusted operator — poker results live off-chain.
 */
export circuit settle(player: UserAddress, amount: Uint<128>): [] {
  assert(deriveHouseKey(houseKey()) == house, "Only house can settle");
  assert(disclose(amount) <= vaultBalance, "Claim exceeds vault balance");
  claimable.insert(disclose(player), disclose(amount));
}

/**
 * Claim settled winnings: 95% to player, 5% to treasury.
 */
export circuit claim(player: UserAddress): [] {
  assert(claimable.member(disclose(player)), "Nothing to claim");
  const amount = claimable.lookup(disclose(player));
  assert(disclose(amount) > 0, "Claim amount is zero");
  assert(disclose(amount) <= vaultBalance, "Vault shortfall");
  assert(
    unshieldedBalanceGte(nativeToken(), amount),
    "Contract unshielded balance too low"
  );

  const fee = disclose(
    ((amount * (treasuryFeeBps as Uint<128>)) / 10000) as Uint<128>
  );
  const toPlayer = disclose((amount - fee) as Uint<128>);

  sendUnshielded(
    nativeToken(),
    toPlayer,
    right<ContractAddress, UserAddress>(disclose(player))
  );

  if (disclose(fee) > 0) {
    sendUnshielded(
      nativeToken(),
      fee,
      right<ContractAddress, UserAddress>(treasury)
    );
    totalTreasuryFees = disclose((totalTreasuryFees + fee) as Uint<128>);
  }

  claimable.insert(disclose(player), 0);
  vaultBalance = disclose((vaultBalance - amount) as Uint<128>);
  totalClaimed = disclose((totalClaimed + toPlayer) as Uint<128>);
}

pure circuit deriveHouseKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "poker-pool:house:v1"),
    sk,
  ]);
}
